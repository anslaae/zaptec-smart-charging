# Postgres connection string. In Vercel, use the Vercel Postgres (Neon) pooled
# connection string (POSTGRES_URL). For local dev, any Postgres instance works.
DATABASE_URL=postgres://user:password@localhost:5432/zaptec_smart_charging

# Random 32+ char secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Your Zaptec account email/password, used as a service-account credential for
# the OAuth2 Resource Owner Password flow. This account must have owner/service
# access to the charger(s) you want to control.
ZAPTEC_USERNAME=
ZAPTEC_PASSWORD=

# Secret the scheduler cron trigger must send as "Authorization: Bearer
# <value>" when calling /api/cron/tick (see .github/workflows/scheduler-tick.yml).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Basic auth credentials you choose yourself and configure in the Zaptec
# Portal's webhook authentication settings for the session-end webhook.
ZAPTEC_WEBHOOK_USERNAME=
ZAPTEC_WEBHOOK_PASSWORD=

# Web Push VAPID keypair, used to sign/encrypt push notifications. Optional --
# without these, push notifications silently no-op rather than breaking the
# app. Generate with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key must be duplicated into NEXT_PUBLIC_VAPID_PUBLIC_KEY (same
# value) since the browser needs it client-side to subscribe.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
